# Settings for `uv run thread-online` (on Fly, set these in fly.toml [env] or with `fly secrets set`).

# Required online: encrypts Canvas tokens, feed links, Google sign-ins and TOTP secrets at rest.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it as a secret, never commit it.
THREAD_SECRET_KEY=

# The public address AI apps use (OAuth issuer and MCP resource).
THREAD_PUBLIC_URL=http://127.0.0.1:8770
THREAD_HOST=127.0.0.1
THREAD_PORT=8770

# Where accounts (accounts.json, Google client) and per-user folders live.
THREAD_CONFIG_DIR=~/.config/thread
THREAD_DATA_DIR=~/.config/thread/data

# Shown on /privacy, /terms and /support.
THREAD_OPERATOR=
THREAD_SUPPORT_EMAIL=

# Default "<name> invited you" for `thread-admin invite`.
THREAD_INVITER=

# Single-user mode (`thread-home`, `thread`): where the notes live (default ~/thread-brain).
THREAD_BRAIN_DIR=
